# Local Django configuration. Do not use production values here.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-unique-local-only-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://beanco:beanco@localhost:5432/beanco
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_LOG_LEVEL=INFO
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BeanCo <noreply@beanco.example>
STAFF_NOTIFICATION_EMAIL=partnerships@beanco.example
INQUIRY_THROTTLE_RATE=5/hour
NEWSLETTER_THROTTLE_RATE=10/hour

# Required only by config.settings.production. Store real values in the provider
# secret manager, never in this file or another file committed to the repository.
