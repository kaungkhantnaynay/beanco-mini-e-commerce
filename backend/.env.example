# Local Django configuration. Do not use production values here.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-unique-local-only-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://beanco:beanco@localhost:5432/beanco
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_LOG_LEVEL=INFO
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ACCOUNT_EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
PAYMENT_EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
DEFAULT_FROM_EMAIL=BeanCo <noreply@beanco.example>
STAFF_NOTIFICATION_EMAIL=partnerships@beanco.example
ACCOUNT_EMAIL_VERIFICATION_URL=http://localhost:3000/account/verify-email
ACCOUNT_PASSWORD_RESET_URL=http://localhost:3000/account/reset-password
INQUIRY_THROTTLE_RATE=5/hour
NEWSLETTER_THROTTLE_RATE=10/hour
CART_THROTTLE_RATE=60/hour
CHECKOUT_THROTTLE_RATE=20/hour
ORDER_THROTTLE_RATE=10/hour
REGISTRATION_THROTTLE_RATE=5/hour
LOGIN_THROTTLE_RATE=10/minute
PASSWORD_RESET_THROTTLE_RATE=5/hour
ACCOUNT_AUTH_THROTTLE_RATE=20/hour
PAYMENT_THROTTLE_RATE=20/hour
CART_COOKIE_NAME=beanco_cart
CART_COOKIE_SECURE=false
SESSION_COOKIE_NAME=beanco_sessionid
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_NAME=beanco_csrftoken
CSRF_COOKIE_SECURE=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:3000/orders/{order_id}?payment=return&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/orders/{order_id}?payment=cancelled

