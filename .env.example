# Server-side Django API URL. In hosted environments this may use private networking.
API_BASE_URL=http://localhost:8000/api/v1

# Browser-accessible Django API URL used by interactive requests. For testing from
# another device, replace localhost with this workstation's current LAN IPv4 address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Must match the backend's CSRF_COOKIE_NAME. The authenticated session remains HTTP-only.
NEXT_PUBLIC_CSRF_COOKIE_NAME=beanco_csrftoken

# Approved media origin used by next/image. Set this to the configured Supabase Storage
# delivery origin when deploying the preview storefront.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media

# Server-only Customer Support AI origin. Run it on a separate local port from Django.
# Do not rename this with a NEXT_PUBLIC_ prefix.
SUPPORT_API_BASE_URL=http://127.0.0.1:8001

# Optional comma-separated hostnames used to access the Next.js dev server from
# another device. Local non-loopback IPv4 addresses are detected automatically.
BEANCO_DEV_ALLOWED_ORIGINS=
