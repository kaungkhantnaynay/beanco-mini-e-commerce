# Server-side Django API URL. In hosted environments this may use private networking.
API_BASE_URL=http://localhost:8000/api/v1

# Browser-accessible Django API URL used by inquiry and newsletter submissions.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Approved public media origin used by next/image. Set this to the production R2
# delivery origin when deploying the storefront.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
